{
  "manifest_version": 3,
  "name": "DerivNova Analyzer",
  "version": "1.0.0",
  "description": "Real-time Deriv market analysis, digit contract signals and charting.",
  "permissions": ["storage", "sidePanel", "windows", "notifications"],
  "host_permissions": ["https://*.deriv.com/*", "https://api.derivws.com/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' wss://api.derivws.com;" },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "icons": { "16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png" },
  "action": { "default_title": "Open DerivNova Analyzer", "default_popup": "src/popup.html", "default_icon": { "16": "assets/icon16.png", "48": "assets/icon48.png" } },
  "side_panel": { "default_path": "src/panel.html" },
  "content_scripts": [{ "matches": ["https://*.deriv.com/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle" }]
}
